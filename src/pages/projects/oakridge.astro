---
import Layout from "../../layouts/Layout.astro";
import { getProjectBySlug } from "../../data/projects";

const project = getProjectBySlug("oakridge");
---

<Layout title={`${project?.name} - Kentwood Homes`}>
    <main class="pt-20">
        <!-- Full-Width Map Hero -->
        <section class="relative">
            <div class="w-full h-[50vh] md:h-[60vh] min-h-[400px]">
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2607.5!2d-123.127!3d49.218!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x5486739a4b4b4b4b%3A0x0!2sOak%20St%20%26%20W%2045th%20Ave%2C%20Vancouver%2C%20BC!5e0!3m2!1sen!2sca!4v1702951200000!5m2!1sen!2sca"
                    width="100%"
                    height="100%"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title="Oakridge Location Map"></iframe>
            </div>
        </section>

        <!-- Project Info Section -->
        <section class="pt-12 pb-[100px] bg-white border-b border-gray-100">
            <div class="container">
                <div
                    class="flex flex-col md:flex-row md:items-start md:justify-between gap-6"
                >
                    <div class="space-y-4">
                        <div
                            class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-4"
                        >
                            <h1
                                class="text-3xl md:text-4xl font-bold text-secondary"
                            >
                                {project?.name}
                            </h1>
                            <span class="text-secondary/60 text-lg">
                                | {project?.location}
                            </span>
                        </div>

                        <!-- Coming Soon Badge -->
                        <div class="space-y-1">
                            <p class="text-secondary/60">
                                Six 3-Bedroom Multiplexes
                            </p>
                            <p
                                class="text-primary font-bold uppercase tracking-wide"
                            >
                                COMING SOON
                            </p>
                            <p class="text-secondary/60">
                                Register for latest updates
                            </p>
                        </div>
                    </div>

                    <a
                        href="/register"
                        class="bg-primary text-white px-8 py-3 rounded-full font-bold text-sm uppercase tracking-wide hover:bg-primary/90 transition-colors inline-block text-center shadow-md w-fit order-last md:order-none"
                    >
                        Register Now
                    </a>
                </div>
            </div>
        </section>
    </main>
</Layout>
