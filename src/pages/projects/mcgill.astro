---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getProjectBySlug } from "../../data/projects";

import mcgillRender from "../../assets/mcgill-render.png";

const project = getProjectBySlug("mcgill");
---

<Layout title={project?.name || ""}>
    <main class="pt-20">
        <!-- Full-Width Hero Image -->
        <section class="relative">
            <Image
                src={mcgillRender}
                alt="McGill Multiplex - Modern living in Vancouver"
                class="w-full h-[50vh] md:h-[60vh] lg:h-[70vh] object-cover"
            />
        </section>

        <!-- Project Info Section -->
        <section class="py-12 bg-white">
            <div class="container">
                <!-- Title Row with Register Button -->
                <div
                    class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-4"
                >
                    <div
                        class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-4"
                    >
                        <h1
                            class="text-3xl md:text-4xl font-bold text-secondary"
                        >
                            {project?.name}
                        </h1>
                        <span class="text-secondary/60 text-lg">
                            | {project?.location}
                        </span>
                    </div>

                    <div class="flex flex-col md:flex-row gap-4 items-center">
                        <a
                            href="/register"
                            class="bg-primary text-white px-8 py-3 rounded-full font-bold text-sm uppercase tracking-wide hover:bg-primary/90 transition-colors inline-block text-center shadow-md w-fit order-last md:order-none"
                        >
                            Register Now
                        </a>
                    </div>
                </div>

                <!-- Project Status -->
                <div class="space-y-1 mb-8">
                    <p class="text-secondary/60 text-lg">
                        {project?.units}
                    </p>
                    <p class="text-primary font-bold uppercase tracking-wide">
                        COMING SOON
                    </p>
                    <p class="text-secondary/60">Register for latest updates</p>
                </div>

                <!-- Content Grid -->
                <div class="grid lg:grid-cols-2 gap-12 items-start">
                    <!-- Left: Description -->
                    <div class="space-y-6">
                        <p class="text-secondary/70 leading-relaxed text-lg">
                            Exquisitely engineered net-zero residences
                            integrating solar energy, metal roofing, EV-ready
                            charging, and energy efficient construction.
                            Designed for refined comfort, sustainable living,
                            and lasting value in a sought-after urban
                            neighbourhood.
                        </p>
                    </div>

                    <!-- Right: Map -->
                    <div
                        class="rounded-xl overflow-hidden shadow-lg h-[300px] lg:h-[350px]"
                    >
                        <iframe
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2604.5!2d-123.0464251!3d49.2890005!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x548670e16bf43d4b%3A0x68996a7cb5b9ce2d!2s2803%20McGill%20St%2C%20Vancouver%2C%20BC%20V5K%201H7!5e0!3m2!1sen!2sca!4v1702951200000!5m2!1sen!2sca"
                            width="100%"
                            height="100%"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                            title="McGill Street Location Map"></iframe>
                    </div>
                </div>
            </div>
        </section>

        <!-- Project Features Section -->
        <!-- <section id="details" class="py-24 bg-bg-cream">
            <div class="container">
                <h2 class="text-3xl font-bold text-secondary mb-12">
                    Project <span class="text-primary italic">Features</span>
                </h2>
                <div class="grid md:grid-cols-3 gap-8">
                    <div class="bg-white p-8 rounded-2xl shadow-sm space-y-4">
                        <h3 class="text-xl font-bold text-secondary">
                            Smart Efficiency
                        </h3>
                        <p class="text-secondary/60 leading-relaxed">
                            Built with the latest energy-efficient technologies
                            to reduce costs and environmental footprint.
                        </p>
                    </div>
                    <div class="bg-white p-8 rounded-2xl shadow-sm space-y-4">
                        <h3 class="text-xl font-bold text-secondary">
                            Modern Design
                        </h3>
                        <p class="text-secondary/60 leading-relaxed">
                            Clean lines, open-concept living, and premium
                            finishes standard in every home.
                        </p>
                    </div>
                    <div class="bg-white p-8 rounded-2xl shadow-sm space-y-4">
                        <h3 class="text-xl font-bold text-secondary">
                            Prime Location
                        </h3>
                        <p class="text-secondary/60 leading-relaxed">
                            Situated in one of the most sought-after
                            neighborhoods with easy access to transit and
                            amenities.
                        </p>
                    </div>
                </div>
            </div>
        </section> -->
    </main>
</Layout>
