---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

import kwh1 from "../assets/kwh-1.png";
import woh1 from "../assets/woh-1.png";
import woh2 from "../assets/woh-2.png";
import bop1 from "../assets/bop-1.png";
import bop2 from "../assets/bop-2.png";
import bop3 from "../assets/bop-3.png";
import tka1 from "../assets/tka-1.png";
---

<Layout title="About Us">
    <main class="pt-20">
        <!-- Hero Section -->
        <section id="our-story" class="py-24 bg-white scroll-mt-20">
            <div class="container">
                <div
                    class="flex flex-col lg:flex-row items-start gap-12 lg:gap-16"
                >
                    <!-- Left Column: Text Content -->
                    <div class="lg:w-7/12 space-y-6" data-aos="fade-right">
                        <h1
                            class="text-5xl md:text-6xl font-bold uppercase tracking-tight leading-none"
                        >
                            KENT<span class="text-primary">WOOD</span><br />
                            HOMES
                        </h1>
                        <p class="text-xl font-semibold text-secondary/80">
                            Our Story
                        </p>
                        <div
                            class="text-secondary/70 leading-relaxed space-y-4"
                        >
                            <p>
                                As an award-winning home builder, Kentwood Homes
                                brings deep industry experience to custom homes
                                and multiplex projects. Sustainability and
                                innovation guide our approach, leading us to
                                adopt new technologies such as Net Zero training
                                and intelligent construction management tools.
                                We are committed to building modern multiplex
                                homes through a smarter and more efficient
                                construction process.
                            </p>
                            <p>
                                Learn more about our approach at <a
                                    target="_blank"
                                    href="https://www.kentwoodhomes.ca"
                                    class="text-secondary hover:text-primary transition-colors"
                                    >www.kentwoodhomes.ca</a
                                >.
                            </p>
                        </div>
                    </div>
                    <!-- Right Column: Image -->
                    <div class="lg:w-5/12" data-aos="fade-left">
                        <Image
                            src={kwh1}
                            alt="Kentwood Home"
                            class="rounded-xl w-full"
                        />
                    </div>
                </div>
            </div>
        </section>

        <!-- Why Our Homes Stand Above The Rest -->
        <section id="our-difference" class="py-24 bg-bg-cream scroll-mt-20">
            <div class="container">
                <div class="flex flex-col lg:flex-row gap-12 lg:gap-20">
                    <!-- Left Column: Stacked Images -->
                    <div
                        class="lg:w-2/5 flex flex-col gap-6"
                        data-aos="fade-right"
                    >
                        <Image
                            src={woh1}
                            alt="Modern dining space"
                            class="rounded-xl shadow-lg w-full object-cover"
                        />
                        <Image
                            src={woh2}
                            alt="Elegant bathroom"
                            class="rounded-xl shadow-lg w-full object-cover"
                        />
                    </div>

                    <!-- Right Column: Text Content -->
                    <div class="lg:w-3/5 space-y-6" data-aos="fade-left">
                        <!-- Main Heading -->
                        <h2
                            class="text-4xl md:text-5xl font-bold text-secondary leading-tight uppercase"
                        >
                            Why Our Homes<br />
                            <span class="text-primary">Stand Above</span><br />
                            the Rest
                        </h2>

                        <!-- Our Difference Subtitle -->
                        <h3 class="text-xl font-bold text-secondary">
                            Our Difference
                        </h3>

                        <!-- Intro Paragraph -->
                        <p class="text-secondary/70 leading-relaxed">
                            Kentwood Homes brings together experience,
                            innovation and a commitment to better building to
                            redefine multiplex living in Vancouver. Here's what
                            truly sets us apart.
                        </p>

                        <!-- Feature Sections -->
                        <div class="space-y-6 pt-2">
                            <div>
                                <h4 class="text-lg font-bold text-primary mb-2">
                                    On Time. On Budget. On Vision.
                                </h4>
                                <p class="text-secondary/70 leading-relaxed">
                                    With intelligent construction management and
                                    streamlined processes, we maintain
                                    exceptional cost control, allowing savings
                                    and efficiencies to be passed directly to
                                    the homeowner.
                                </p>
                            </div>

                            <div>
                                <h4 class="text-lg font-bold text-primary mb-2">
                                    Smoother Approvals. Stronger Builds.
                                </h4>
                                <p class="text-secondary/70 leading-relaxed">
                                    Our process is built to deliver top-tier
                                    quality from initial planning to move-in
                                    day. With deep experience navigating
                                    Vancouver's evolving bylaws, zoning shifts
                                    and permit complexities, Kentwood Homes
                                    optimizes design and construction to ensure
                                    a faster, hassle-free process.
                                </p>
                            </div>

                            <div>
                                <h4 class="text-lg font-bold text-primary mb-2">
                                    Sustainable Design. Innovative Methods.
                                </h4>
                                <p class="text-secondary/70 leading-relaxed">
                                    Sustainability is a foundation at Kentwood
                                    Homes. From thoughtful material selection to
                                    innovative design strategies, every home is
                                    shaped to support eco-living and long-term
                                    performance. Our team continually upgrades
                                    its training and embraces new technologies
                                    to elevate efficiency, wellness and
                                    environmental responsibility.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- The Kentwood Approach -->
        <section id="our-process" class="py-24 bg-white scroll-mt-20">
            <div class="container">
                <!-- Section Header -->
                <h2
                    class="text-4xl md:text-5xl font-bold text-secondary mb-2 uppercase"
                >
                    The <span class="text-primary">Kentwood</span> Approach
                </h2>
                <h3 class="text-xl font-semibold text-secondary/80 mb-12">
                    Our Process
                </h3>

                <div class="flex flex-col lg:flex-row gap-12 lg:gap-16">
                    <!-- Left Column: Text Content -->
                    <div class="lg:w-7/12 space-y-8" data-aos="fade-right">
                        <!-- Planning & Acquisition -->
                        <div>
                            <h4 class="text-lg font-bold text-primary mb-2">
                                Planning & Acquisition
                            </h4>
                            <p class="text-secondary/70 leading-relaxed">
                                Not every lot is suitable for multiplex
                                development. During the planning phase, Kentwood
                                prioritizes affordability, comfort resiliency,
                                and efficiency to ensure each project starts on
                                the strongest foundation.
                            </p>
                        </div>

                        <!-- Design -->
                        <div>
                            <h4 class="text-lg font-bold text-primary mb-2">
                                Design
                            </h4>
                            <p class="text-secondary/70 leading-relaxed">
                                Every home begins with thoughtful,
                                criteria-driven design. Working within zoning
                                guidelines, energy codes, and land
                                characteristics, we shape layouts that meet
                                requirements while aligning with the lifestyle
                                needs of future homeowners. From quality
                                finishes to high-efficiency systems, Kentwood
                                delivers durable homes with lasting comfort and
                                energy savings.
                            </p>
                        </div>

                        <!-- Building & Development -->
                        <div>
                            <h4 class="text-lg font-bold text-primary mb-2">
                                Building & Development
                            </h4>
                            <p class="text-secondary/70 leading-relaxed">
                                During construction, we use an intelligent
                                management tool to closely monitor progress,
                                ensuring quality work stays on budget and on
                                schedule. This approach helps manage resources
                                efficiently and allows us to navigate changes
                                quickly.
                            </p>
                            <p class="text-secondary/70 leading-relaxed mt-4">
                                As sustainability leaders, Kentwood Homes is
                                certified as a "Net Zero Qualified Builder",
                                offering Net Zero ready homes with modern
                                designs and eco-conscious living.
                            </p>
                        </div>

                        <!-- Post Development Care -->
                        <div>
                            <h4 class="text-lg font-bold text-primary mb-2">
                                Post Development Care
                            </h4>
                            <p class="text-secondary/70 leading-relaxed">
                                From your first inquiry to move-in and beyond,
                                our team is here to guide, communicate and
                                ensure a seamless experience. At Kentwood, we
                                strive to build connections that extend well
                                past the walls of your home.
                            </p>
                        </div>
                    </div>

                    <!-- Right Column: 2x2 Image Grid -->
                    <div class="lg:w-5/12" data-aos="fade-left">
                        <Image
                            src={tka1}
                            alt="Building framework"
                            class="w-full"
                        />
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>
