---
import { Image } from "astro:assets";
import logo from "../assets/footer-logo.svg";
import warrantyLogos from "../assets/2510-os.svg";
import kwLogo from "../assets/footer/kw.png";
import georgieAward from "../assets/footer/2024-ga-finalist.png";
import havanAward from "../assets/footer/havan-award.png";
import { projects } from "../data/projects";
import { company } from "../data/company";
---

<footer class="bg-secondary text-white pt-24 pb-0 relative overflow-hidden">
    <div class="container">
        <!-- Top Section -->
        <div class="grid md:grid-cols-12 gap-12 mb-10">
            <!-- Left: Logo & Contact -->
            <div class="md:col-span-5 space-y-8">
                <a href="/" class="inline-block">
                    <Image
                        src={logo}
                        alt="Kentwood Multiplex Logo"
                        class="h-16 w-auto"
                    />
                </a>
                <div
                    class="space-y-1 text-base text-white/80 font-medium leading-relaxed"
                >
                    <a
                        href={company.address.mapLink}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-primary transition-colors block"
                    >
                        <p>{company.address.line1}</p>
                        <p>{company.address.line2}</p>
                    </a>
                    <p>
                        <a
                            href={company.emailLink}
                            class="hover:text-primary transition-colors"
                            >{company.email}</a
                        >
                    </p>
                    <p>
                        <a
                            href={company.phoneLink}
                            class="hover:text-primary transition-colors"
                        >
                            {company.phone}
                        </a>
                    </p>
                </div>
            </div>

            <!-- Right: Navigation Links -->
            <div
                class="md:col-span-7 flex flex-wrap justify-start md:justify-between gap-y-12 gap-x-5"
            >
                <div class="space-y-6 min-w-[200px]">
                    <h4
                        class="font-black uppercase tracking-widest text-sm text-white whitespace-nowrap"
                    >
                        Featured Projects
                    </h4>
                    <ul class="text-white/70 text-base font-medium space-y-0">
                        {
                            projects.map((project) => (
                                <li>
                                    <a
                                        href={`/projects/${project.slug}`}
                                        class="hover:text-white transition-colors"
                                    >
                                        {project.name}
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <div class="space-y-6">
                    <h4
                        class="font-black uppercase tracking-widest text-sm text-white whitespace-nowrap"
                    >
                        About
                    </h4>
                    <ul class="text-white/70 text-base font-medium space-y-0">
                        <li>
                            <a
                                href="/about#our-story"
                                class="hover:text-white transition-colors"
                                >Our Story</a
                            >
                        </li>
                        <li>
                            <a
                                href="/about#our-difference"
                                class="hover:text-white transition-colors"
                                >Our Difference</a
                            >
                        </li>
                        <li>
                            <a
                                href="/about#our-process"
                                class="hover:text-white transition-colors"
                                >Our Process</a
                            >
                        </li>
                    </ul>
                </div>

                <div class="flex">
                    <a
                        href="/faq"
                        class="font-black uppercase tracking-widest text-sm text-white hover:text-primary transition-colors whitespace-nowrap"
                        >FAQs</a
                    >
                </div>

                <div class="flex">
                    <a
                        href="/contact"
                        class="font-black uppercase tracking-widest text-sm text-white hover:text-primary transition-colors whitespace-nowrap"
                        >Contact</a
                    >
                </div>

                <div class="flex">
                    <a
                        href="/register"
                        class="font-black uppercase tracking-widest text-sm text-white hover:text-primary transition-colors whitespace-nowrap"
                        >Register</a
                    >
                </div>
            </div>
        </div>

        <!-- Bottom Logo Section -->
        <div
            class="flex flex-col md:flex-row justify-between items-end gap-12 pb-12"
        >
            <!-- Left: Warranty & OpenSpace -->
            <div class="w-full md:w-auto">
                <Image
                    src={warrantyLogos}
                    alt="2-5-10 Year Warranty and OpenSpace"
                    class="h-16 w-auto"
                />
            </div>

            <!-- Right: Affiliate Partner & Awards -->
            <div class="w-full md:w-auto flex items-center gap-6 h-[96px]">
                <div class="flex flex-col items-center h-full">
                    <p class="text-white text-sm font-medium">
                        An affiliate partner of
                    </p>

                    <div class="flex-1"></div>

                    <Image
                        src={kwLogo}
                        alt="Kentwood Homes"
                        class="h-14 w-auto"
                    />
                </div>
                <Image
                    src={georgieAward}
                    alt="2024 Georgie Award Finalist"
                    class="h-24 w-auto"
                />
                <Image src={havanAward} alt="HAVAN Award" class="h-24 w-auto" />
            </div>
        </div>
    </div>

    <!-- Shaped Legal Bar -->
    <div class="flex justify-center w-full">
        <div
            class="bg-white px-12 py-3 rounded-t-[40px] flex flex-col md:flex-row items-center gap-2 md:gap-8 text-[11px] font-bold uppercase tracking-widest text-secondary shadow-lg"
        >
            <p>©Kentwood Homes.</p>
            <div class="flex items-center gap-4">
                <a href="/privacy" class="hover:text-primary transition-colors"
                    >Privacy Policy</a
                >
                <span class="text-secondary/20">|</span>
                <a href="/terms" class="hover:text-primary transition-colors"
                    >Terms & Conditions</a
                >
            </div>
        </div>
    </div>
</footer>
